MONGODB_URI=
MONGODB_DB=supertech

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_API_KEY=

NEXT_PUBLIC_APP_URL=http://localhost:3000

# AI provider for search, recommendations, support chat, and content generation.
# Leave blank to auto-pick the first provider that has an API key below.
# Set to "openai" or "deepseek" to force one.
AI_PROVIDER=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Optional aliases if your hosting panel labels these as ChatGPT settings.
CHATGPT_API_KEY=
CHATGPT_MODEL=
# Optional: point at an OpenAI-compatible Responses API gateway.
OPENAI_BASE_URL=

# DeepSeek — get a key at https://platform.deepseek.com
# Models: deepseek-chat (general) or deepseek-reasoner (reasoning).
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=

# Google sign-in / One Tap — OAuth 2.0 Web client ID from Google Cloud Console.
# GOOGLE_WEB_CLIENT_ID alone is enough (server + GIS button via server wrapper).
# Optional duplicate for static builds: NEXT_PUBLIC_GOOGLE_WEB_CLIENT_ID
GOOGLE_WEB_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_WEB_CLIENT_ID=

AUTH_SECRET=change-this-before-production
AUTH_DEMO_USERS_JSON=[{"email":"admin@supertech.store","password":"ChangeMe123!","role":"admin","name":"SuperTech Admin"},{"email":"aurora@supertech.store","password":"ChangeMe123!","role":"vendor","name":"Aurora Labs","vendorSlug":"aurora-labs"},{"email":"customer@supertech.store","password":"ChangeMe123!","role":"customer","name":"Customer Account"}]
